# Normalize line endings: store everything with LF in the repo.
* text=auto eol=lf

# Gradle wrapper script must stay LF (it runs on CI Linux runners).
gradlew text eol=lf

# Windows-only scripts keep CRLF.
gradlew.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch.
*.jar binary
*.png binary
*.zip binary
*.ico binary
